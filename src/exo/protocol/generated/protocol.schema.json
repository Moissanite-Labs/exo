{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Exo protocol v1",
  "protocol": 1,
  "commands": {
    "hello": {
      "$ref": "#/$defs/Hello"
    },
    "session.create": {
      "$ref": "#/$defs/SessionCreate"
    },
    "session.list": {
      "$ref": "#/$defs/SessionList"
    },
    "approvals.list": {
      "$ref": "#/$defs/ApprovalsList"
    },
    "session.get": {
      "$ref": "#/$defs/SessionGet"
    },
    "session.fork": {
      "$ref": "#/$defs/SessionFork"
    },
    "session.resume": {
      "$ref": "#/$defs/SessionResume"
    },
    "session.undo": {
      "$ref": "#/$defs/SessionUndo"
    },
    "turn.send": {
      "$ref": "#/$defs/TurnSend"
    },
    "turn.interrupt": {
      "$ref": "#/$defs/TurnInterrupt"
    },
    "approval.respond": {
      "$ref": "#/$defs/ApprovalRespond"
    },
    "question.answer": {
      "$ref": "#/$defs/QuestionAnswer"
    },
    "command.run": {
      "$ref": "#/$defs/CommandRun"
    },
    "commands.list": {
      "$ref": "#/$defs/CommandsList"
    },
    "events.subscribe": {
      "$ref": "#/$defs/EventsSubscribe"
    },
    "search": {
      "$ref": "#/$defs/Search"
    },
    "config.get": {
      "$ref": "#/$defs/ConfigGet"
    },
    "config.set": {
      "$ref": "#/$defs/ConfigSet"
    },
    "models.list": {
      "$ref": "#/$defs/ModelsList"
    },
    "models.set": {
      "$ref": "#/$defs/ModelsSet"
    },
    "tools.list": {
      "$ref": "#/$defs/ToolsList"
    },
    "skills.list": {
      "$ref": "#/$defs/SkillsList"
    },
    "tasks.list": {
      "$ref": "#/$defs/TasksList"
    },
    "seat.list": {
      "$ref": "#/$defs/SeatList"
    },
    "taste.list": {
      "$ref": "#/$defs/TasteList"
    },
    "taste.edit": {
      "$ref": "#/$defs/TasteEdit"
    },
    "feedback.send": {
      "$ref": "#/$defs/FeedbackSend"
    },
    "ui.respond": {
      "$ref": "#/$defs/UiRespond"
    },
    "schedule.edit": {
      "$ref": "#/$defs/ScheduleEdit"
    },
    "peers": {
      "$ref": "#/$defs/Peers"
    }
  },
  "events": {
    "session.created": {
      "$ref": "#/$defs/SessionCreated"
    },
    "session.updated": {
      "$ref": "#/$defs/SessionUpdated"
    },
    "turn.started": {
      "$ref": "#/$defs/TurnStarted"
    },
    "turn.completed": {
      "$ref": "#/$defs/TurnCompleted"
    },
    "message.delta": {
      "$ref": "#/$defs/MessageDelta"
    },
    "message.completed": {
      "$ref": "#/$defs/MessageCompleted"
    },
    "reasoning.delta": {
      "$ref": "#/$defs/ReasoningDelta"
    },
    "tool.started": {
      "$ref": "#/$defs/ToolStarted"
    },
    "tool.output": {
      "$ref": "#/$defs/ToolOutput"
    },
    "tool.completed": {
      "$ref": "#/$defs/ToolCompleted"
    },
    "approval.requested": {
      "$ref": "#/$defs/ApprovalRequested"
    },
    "approval.resolved": {
      "$ref": "#/$defs/ApprovalResolved"
    },
    "steer.cancelled": {
      "$ref": "#/$defs/SteerCancelled"
    },
    "question.asked": {
      "$ref": "#/$defs/QuestionAsked"
    },
    "context.compacted": {
      "$ref": "#/$defs/ContextCompacted"
    },
    "memory.summarized": {
      "$ref": "#/$defs/MemorySummarized"
    },
    "job.updated": {
      "$ref": "#/$defs/JobUpdated"
    },
    "handoff.written": {
      "$ref": "#/$defs/HandoffWritten"
    },
    "task.updated": {
      "$ref": "#/$defs/TaskUpdated"
    },
    "usage.updated": {
      "$ref": "#/$defs/UsageUpdated"
    },
    "decision.queued": {
      "$ref": "#/$defs/DecisionQueued"
    },
    "taste.updated": {
      "$ref": "#/$defs/TasteUpdated"
    },
    "ui.panel": {
      "$ref": "#/$defs/UiPanel"
    },
    "peer.message": {
      "$ref": "#/$defs/PeerMessage"
    },
    "peer.delivery": {
      "$ref": "#/$defs/PeerDelivery"
    },
    "model.call": {
      "$ref": "#/$defs/ModelCall"
    },
    "harness.error": {
      "$ref": "#/$defs/HarnessError"
    },
    "notice": {
      "$ref": "#/$defs/Notice"
    },
    "error": {
      "$ref": "#/$defs/Error"
    }
  },
  "$defs": {
    "ApprovalRequested": {
      "type": "object",
      "properties": {
        "request_id": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "risk": {
          "type": "string",
          "default": "medium"
        },
        "call": {
          "anyOf": [
            {
              "$ref": "#/$defs/ToolCall"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "options": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "allow",
            "deny",
            "allow_always"
          ]
        },
        "approvers": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "binding": {
          "type": "string",
          "default": ""
        }
      },
      "additionalProperties": false,
      "required": [
        "request_id",
        "summary"
      ],
      "description": "Server-to-client request; any client answers with approval.respond."
    },
    "ApprovalResolved": {
      "type": "object",
      "properties": {
        "request_id": {
          "type": "string"
        },
        "decision": {
          "type": "string"
        },
        "by": {
          "type": "string",
          "default": ""
        }
      },
      "additionalProperties": false,
      "required": [
        "request_id",
        "decision"
      ]
    },
    "ApprovalRespond": {
      "type": "object",
      "properties": {
        "request_id": {
          "type": "string"
        },
        "decision": {
          "enum": [
            "allow",
            "deny",
            "allow_always"
          ]
        },
        "note": {
          "type": "string",
          "default": ""
        },
        "client": {
          "type": "string",
          "default": ""
        },
        "binding": {
          "type": "string",
          "default": ""
        },
        "sig": {
          "type": "string",
          "default": ""
        }
      },
      "additionalProperties": false,
      "required": [
        "request_id",
        "decision"
      ]
    },
    "ApprovalsList": {
      "type": "object",
      "properties": {
        "session": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "additionalProperties": false,
      "description": "Approvals still waiting for an answer (a client that connects late can show and answer them)."
    },
    "Command": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "body": {},
        "id": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "type",
        "body"
      ],
      "description": "Client to server. ``id`` correlates the Response."
    },
    "CommandRun": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "args": {
          "type": "string",
          "default": ""
        },
        "session": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "description": "Run a slash command, e.g. name=\"exo\", args=\"handoff\". The core answers some built-in commands itself (the command cap is full, so new ones go here, not in new command types): ``trace``, ``findings``, ``context`` (what the next model call for ``session`` carries, read-only) and ``compact`` (summarize now what is eligible in the agent's memory; runs in the core that holds the agent lock) and ``unsteer`` (pull back a queued steer message before it is delivered: args is its id, empty means the newest, D-045) and ``rename`` (set the session title to args, principal only, announced as ``session.updated``, D-069)."
    },
    "CommandsList": {
      "type": "object",
      "properties": {
        "session": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "additionalProperties": false
    },
    "ConfigGet": {
      "type": "object",
      "properties": {
        "key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "additionalProperties": false
    },
    "ConfigSet": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string"
        },
        "value": {
          "default": null
        }
      },
      "additionalProperties": false,
      "required": [
        "key"
      ]
    },
    "ContentPart": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "text",
            "image",
            "reasoning"
          ]
        },
        "text": {
          "type": "string",
          "default": ""
        },
        "data": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "mime": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "signature": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "description": "One piece of message content. text: ``text`` holds the text. image: ``data`` is base64, ``mime`` its type (or ``url`` instead of data). reasoning: ``text`` holds the thinking; ``signature`` is the provider's opaque token that must be sent back unchanged (Anthropic thinking blocks)."
    },
    "ContextCompacted": {
      "type": "object",
      "properties": {
        "before_tokens": {
          "type": "integer"
        },
        "after_tokens": {
          "type": "integer"
        },
        "summary_message_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "additionalProperties": false,
      "required": [
        "before_tokens",
        "after_tokens"
      ]
    },
    "DecisionQueued": {
      "type": "object",
      "properties": {
        "decision_id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "source": {
          "type": "string",
          "default": ""
        },
        "detail": {
          "type": "string",
          "default": ""
        }
      },
      "additionalProperties": false,
      "required": [
        "decision_id",
        "title"
      ]
    },
    "Error": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "retryable": {
          "type": "boolean",
          "default": false
        },
        "command_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ]
    },
    "ErrorInfo": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "retryable": {
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ]
    },
    "Event": {
      "type": "object",
      "properties": {
        "seq": {
          "type": "integer"
        },
        "type": {
          "type": "string"
        },
        "body": {},
        "session": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "ts": {
          "type": "string"
        },
        "id": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "seq",
        "type",
        "body"
      ],
      "description": "Server to clients. ``seq`` is assigned by the server, strictly increasing across the whole stream; ``session`` is None for global events."
    },
    "EventsSubscribe": {
      "type": "object",
      "properties": {
        "since": {
          "type": "integer",
          "default": 0
        },
        "session": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "additionalProperties": false,
      "description": "Stream events with seq > since. session=None means all sessions."
    },
    "FeedbackSend": {
      "type": "object",
      "properties": {
        "session": {
          "type": "string"
        },
        "verdict": {
          "enum": [
            "accept",
            "edit",
            "reject",
            "should_have_been"
          ]
        },
        "message_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "text": {
          "type": "string",
          "default": ""
        }
      },
      "additionalProperties": false,
      "required": [
        "session",
        "verdict"
      ],
      "description": "The principal's verdict on an answer: the learning loop's main signal (D-009, D-022). edit and should_have_been carry the better version in text."
    },
    "HandoffWritten": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "summary": {
          "type": "string",
          "default": ""
        }
      },
      "additionalProperties": false,
      "required": [
        "path"
      ]
    },
    "HarnessError": {
      "type": "object",
      "properties": {
        "where": {
          "type": "string"
        },
        "error_type": {
          "type": "string",
          "default": ""
        },
        "message": {
          "type": "string",
          "default": ""
        },
        "traceback": {
          "type": "string",
          "default": ""
        }
      },
      "additionalProperties": false,
      "required": [
        "where"
      ],
      "description": "An exception the harness caught in a hook, handler, plugin or client event path (D-025). Never holds keys, headers or environment values (scrubbed before it is written)."
    },
    "Hello": {
      "type": "object",
      "properties": {
        "protocol": {
          "type": "integer",
          "default": 1
        },
        "client": {
          "type": "string",
          "default": ""
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "screen_cols": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "additionalProperties": false,
      "description": "Handshake. Server replies with its protocol version and capabilities."
    },
    "JobUpdated": {
      "type": "object",
      "properties": {
        "job_id": {
          "type": "string"
        },
        "state": {
          "type": "string",
          "default": "running"
        },
        "command": {
          "type": "string",
          "default": ""
        },
        "exit_code": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "elapsed_ms": {
          "type": "integer",
          "default": 0
        },
        "log": {
          "type": "string",
          "default": ""
        },
        "detail": {
          "type": "string",
          "default": ""
        }
      },
      "additionalProperties": false,
      "required": [
        "job_id"
      ],
      "description": "A background shell job changed state (D-032, docs/JOBS.md): ``running`` when it starts, then one of ``done`` (exit 0), ``failed`` (non-zero exit), ``killed``, ``timeout`` or ``lost`` (exod restarted). One type with a state, as ``task.updated`` does, because the protocol has few event slots left."
    },
    "MemorySummarized": {
      "type": "object",
      "properties": {
        "node_id": {
          "type": "string"
        },
        "level": {
          "type": "integer"
        },
        "start": {
          "type": "integer"
        },
        "end": {
          "type": "integer"
        },
        "before_tokens": {
          "type": "integer"
        },
        "after_tokens": {
          "type": "integer"
        },
        "tree": {
          "type": "string",
          "default": ""
        }
      },
      "additionalProperties": false,
      "required": [
        "node_id",
        "level",
        "start",
        "end",
        "before_tokens",
        "after_tokens"
      ],
      "description": "One node of a summary tree finished (D-028): a leaf over log entries ``start``-``end`` or a merge of two nodes. Upkeep of memory, not a compaction of the live context (that is ``context.compacted``)."
    },
    "Message": {
      "type": "object",
      "properties": {
        "role": {
          "enum": [
            "system",
            "user",
            "assistant",
            "tool"
          ]
        },
        "content": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ContentPart"
          },
          "default": []
        },
        "tool_calls": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ToolCall"
          },
          "default": []
        },
        "tool_results": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ToolResult"
          },
          "default": []
        },
        "id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "meta": {
          "type": "object",
          "default": {}
        }
      },
      "additionalProperties": false,
      "required": [
        "role"
      ],
      "description": "One conversation message in Exo's provider-neutral shape. assistant messages may carry ``tool_calls``; ``tool`` messages carry ``tool_results`` (one or more; transports split or merge as their API needs). ``meta`` is free-form and never sent to a provider (cache hints, origin, seq)."
    },
    "MessageCompleted": {
      "type": "object",
      "properties": {
        "message": {
          "$ref": "#/$defs/Message"
        }
      },
      "additionalProperties": false,
      "required": [
        "message"
      ]
    },
    "MessageDelta": {
      "type": "object",
      "properties": {
        "message_id": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "message_id",
        "text"
      ]
    },
    "ModelCall": {
      "type": "object",
      "properties": {
        "iteration": {
          "type": "integer",
          "default": 0
        },
        "role": {
          "type": "string",
          "default": ""
        },
        "requested": {
          "type": "string",
          "default": ""
        },
        "route": {
          "type": "string",
          "default": ""
        },
        "attempts": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "default": []
        },
        "ttft_ms": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "total_ms": {
          "type": "integer",
          "default": 0
        },
        "usage": {
          "anyOf": [
            {
              "$ref": "#/$defs/Usage"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "stop_reason": {
          "type": "string",
          "default": ""
        },
        "error": {
          "type": "string",
          "default": ""
        },
        "retries": {
          "type": "integer",
          "default": 0
        },
        "reasoning": {
          "type": "object",
          "default": {}
        },
        "call_id": {
          "type": "string",
          "default": ""
        }
      },
      "additionalProperties": false,
      "description": "One model call as the harness saw it (D-025): what was asked, which route served it, every attempt. attempts: [{route, outcome: ok|timeout|error|fallback, error, ms}]. ttft_ms is None when nothing streamed."
    },
    "ModelsList": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    },
    "ModelsSet": {
      "type": "object",
      "properties": {
        "model": {
          "type": "string"
        },
        "role": {
          "type": "string",
          "default": "main"
        },
        "session": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "additionalProperties": false,
      "required": [
        "model"
      ]
    },
    "Notice": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string"
        },
        "level": {
          "enum": [
            "info",
            "warn"
          ],
          "default": "info"
        },
        "source": {
          "type": "string",
          "default": ""
        },
        "call_id": {
          "type": "string",
          "default": ""
        }
      },
      "additionalProperties": false,
      "required": [
        "text"
      ]
    },
    "PeerDelivery": {
      "type": "object",
      "properties": {
        "msg_id": {
          "type": "string"
        },
        "state": {
          "enum": [
            "delivered",
            "held",
            "released",
            "denied",
            "expired"
          ]
        },
        "peer": {
          "type": "string",
          "default": ""
        },
